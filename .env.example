# Keys are read only by the backend. Copy to .env; never commit real keys.
LAYERDECK_CLOUD=0
DASHSCOPE_API_KEY=
FAL_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus
# Required conservative maximum cost for 1 image + max_tokens=1024; unknown means blocked.
QWEN_MAX_CALL_USD=
